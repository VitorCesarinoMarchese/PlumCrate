{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "ts4-mod-manager.vercel.app"
        }
      ],
      "destination": "https://plumcrate.vercel.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ts4-mod-manager.vercel.app"
        }
      ],
      "destination": "https://plumcrate.vercel.app/:path*",
      "permanent": true
    }
  ]
}
